{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 180,
      "excludeFiles": "{.env,.env.*,dist/**,public/**}"
    }
  }
}
